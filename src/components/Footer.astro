---
import { siteConfig, navLinks } from '../data/portfolio';
import { withBase } from '../utils/paths';
---

<footer class="site-footer" id="footer" aria-label="Footer">
  <div class="container footer-container">
    <!-- Top Footer Bar -->
    <div class="footer-top">
      <div class="footer-brand">
        <a href={withBase('#hero')} class="brand-monogram" aria-label="Back to top">
          ME<span class="brand-dot">.</span>
        </a>
        <p class="brand-tagline">
          THE SOCIAL EDIT — CREATIVE CONTENT &amp; COMMUNITY MODERATION
        </p>
      </div>

      <nav class="footer-nav" aria-label="Footer Navigation">
        <ul class="footer-links">
          {navLinks.map((link) => (
            <li>
              <a href={withBase(link.href)} class="footer-link">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="footer-back-to-top">
        <a href={withBase('#hero')} class="btn btn-secondary back-to-top-btn" aria-label="Return to top of page">
          <span>Top</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="12" y1="19" x2="12" y2="5"></line>
            <polyline points="5 12 12 5 19 12"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <!-- Bottom Footer Bar -->
    <div class="footer-bottom">
      <p class="copyright-text">
        &copy; {new Date().getFullYear()} Maryem Essam. All rights reserved.
      </p>

      <div class="editorial-signature">
        <span class="star-accent">✦</span> Designed with intention for Maryem Essam
      </div>

      <div class="footer-social-direct">
        <a href={siteConfig.contact.whatsapp} target="_blank" rel="noopener noreferrer" class="social-text-link">WhatsApp</a>
        <span class="sep">/</span>
        <a href={siteConfig.contact.linkedin} target="_blank" rel="noopener noreferrer" class="social-text-link">LinkedIn</a>
        <span class="sep">/</span>
        <a href={siteConfig.contact.phoneTel} class="social-text-link">Call</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-text-primary);
    color: var(--color-bg-primary);
    padding-top: 4rem;
    padding-bottom: 2.5rem;
    border-top: var(--border-bold);
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(246, 240, 230, 0.15);
  }

  @media (min-width: 992px) {
    .footer-top {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .brand-monogram {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--color-bg-primary);
    text-decoration: none;
    line-height: 1;
  }

  .brand-dot {
    color: var(--color-accent);
  }

  .brand-tagline {
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #A39D95;
    text-transform: uppercase;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 1.75rem;
    list-style: none;
  }

  .footer-link {
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 600;
    color: #D9D2C7;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--color-accent);
  }

  .back-to-top-btn {
    padding: 0.65rem 1.25rem;
    font-size: 0.75rem;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
    text-align: center;
    font-size: 0.8125rem;
    color: #8C867E;
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .editorial-signature {
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
    color: #D9D2C7;
  }

  .star-accent {
    color: var(--color-accent);
  }

  .footer-social-direct {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .social-text-link {
    color: #D9D2C7;
    font-weight: 600;
    transition: color var(--transition-fast);
  }

  .social-text-link:hover {
    color: var(--color-accent);
  }

  .sep {
    color: #555049;
  }
</style>
