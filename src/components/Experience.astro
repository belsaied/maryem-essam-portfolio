---
import { experienceData } from '../data/portfolio';
---

<section class="experience-section section-padding" id="experience" aria-label="Education, Certification & Experience">
  <div class="container">
    <!-- Header -->
    <div class="experience-header reveal-item">
      <span class="section-tag">
        <span class="tag-spark">✦</span> MILESTONES &amp; CREDENTIALS
      </span>
      <h2 class="section-title">
        MY JOURNEY <br />
        <span class="font-serif-italic">so far.</span>
      </h2>
      <p class="section-subtitle">
        A grounded trajectory combining academic business knowledge, specialized marketing training, and high-frequency digital retail sales interactions.
      </p>
    </div>

    <!-- Editorial Timeline -->
    <div class="timeline-container">
      <div class="timeline-spine"></div>

      <div class="timeline-items">
        {experienceData.map((item, index) => (
          <div class={`timeline-entry reveal-item reveal-stagger-${index + 1}`}>
            <!-- Left Milestone Pill -->
            <div class="timeline-node">
              <span class={`node-dot ${item.badgeColor}`}></span>
              <span class="node-type-badge">{item.type}</span>
            </div>

            <!-- Content Card -->
            <div class="timeline-card">
              <div class="card-meta">
                <span class="item-institution">{item.institution}</span>
                <span class="item-period editable-badge">{item.period}</span>
              </div>

              <h3 class="item-title">{item.title}</h3>
              <p class="item-description">{item.description}</p>

              <!-- Key Skills Gained -->
              <div class="item-skills">
                <span class="skills-label">APPLIED COMPETENCIES:</span>
                <div class="skills-wrap">
                  {item.keySkills.map((skill) => (
                    <span class="skill-pill">{skill}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .experience-section {
    background-color: #F8F4EC;
    border-bottom: var(--border-thin);
    position: relative;
  }

  .experience-header {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .tag-spark {
    color: var(--color-accent);
  }

  /* Timeline */
  .timeline-container {
    position: relative;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .timeline-spine {
    position: absolute;
    top: 20px;
    bottom: 20px;
    left: 20px;
    width: 3px;
    background-color: var(--color-border);
  }

  @media (min-width: 768px) {
    .timeline-spine {
      left: 36px;
    }
  }

  .timeline-items {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .timeline-entry {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-left: 55px;
  }

  @media (min-width: 768px) {
    .timeline-entry {
      padding-left: 90px;
    }
  }

  /* Node Dot */
  .timeline-node {
    position: absolute;
    left: 8px;
    top: 24px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .timeline-node {
      left: 24px;
    }
  }

  .node-dot {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: var(--border-bold);
    background-color: var(--color-card-bg);
    box-shadow: 2px 2px 0px var(--color-border);
    display: block;
    position: relative;
    z-index: 2;
  }

  .node-dot.sage { background-color: var(--color-bg-secondary); }
  .node-dot.yellow { background-color: var(--color-highlight); }
  .node-dot.orange { background-color: var(--color-accent); }

  .node-type-badge {
    display: none;
  }

  /* Card */
  .timeline-card {
    background-color: var(--color-card-bg);
    border: var(--border-bold);
    border-radius: var(--radius-md);
    padding: 1.75rem 2rem;
    box-shadow: var(--shadow-offset-md);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .timeline-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-offset-lg);
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .item-institution {
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .item-period {
    font-family: var(--font-heading);
    font-size: 0.71875rem;
    font-weight: 700;
    padding: 0.2rem 0.65rem;
    background-color: var(--color-bg-primary);
    border: var(--border-thin);
    border-radius: var(--radius-pill);
    color: var(--color-text-secondary);
  }

  .item-title {
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }

  .item-description {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin-bottom: 1.25rem;
  }

  /* Skills */
  .item-skills {
    padding-top: 1rem;
    border-top: 1px dashed var(--color-border-subtle);
  }

  .skills-label {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: 0.6rem;
  }

  .skills-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-pill {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    color: var(--color-text-primary);
  }
</style>
