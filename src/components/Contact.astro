---
import { siteConfig } from '../data/portfolio';
---

<section class="contact-section section-padding" id="contact" aria-label="Contact Maryem Essam">
  <div class="container">
    <div class="contact-card reveal-item">
      <!-- Top Meta -->
      <div class="contact-top">
        <span class="badge-sticker orange">LET'S CONNECT</span>
        <div class="status-indicator">
          <span class="live-dot"></span>
          <span>Open to Opportunities &amp; Remote Roles</span>
        </div>
      </div>

      <!-- Main Headline -->
      <h2 class="contact-title">
        LET'S MAKE SOMETHING <br />
        <span class="font-serif-italic">people remember.</span>
      </h2>

      <!-- Supporting Copy -->
      <p class="contact-copy">
        Have an opportunity, a project, or an idea? I'd love to hear from you. Reach out through WhatsApp, connect on LinkedIn, or give me a direct call.
      </p>

      <!-- Three Direct Verified Action Buttons -->
      <div class="contact-actions">
        <!-- WhatsApp -->
        <a 
          href={siteConfig.contact.whatsapp} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-primary contact-btn whatsapp-btn"
          aria-label="Chat with Maryem on WhatsApp (opens in a new tab)"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
            <path d="M12.031 2C6.495 2 2 6.494 2 12.03c0 1.97.57 3.81 1.56 5.37L2 22l4.77-1.52c1.49.85 3.2 1.32 5.01 1.32 5.535 0 10.03-4.494 10.03-10.03 0-5.536-4.495-10.03-10.03-10.03zm0 18.28c-1.63 0-3.17-.46-4.5-1.28l-.32-.2-3.14 1 1.02-3.06-.21-.34c-.93-1.42-1.43-3.1-1.43-4.83 0-4.68 3.81-8.49 8.49-8.49s8.49 3.81 8.49 8.49-3.81 8.49-8.49 8.49zm4.65-6.37c-.25-.13-1.5-.74-1.73-.83-.23-.08-.4-.13-.57.13-.17.25-.66.83-.81 1-.15.17-.3.19-.55.06-.25-.13-1.07-.39-2.03-1.25-.75-.67-1.26-1.5-1.41-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.3.38-.45.13-.15.17-.25.25-.42.08-.17.04-.32-.02-.45-.06-.13-.57-1.37-.78-1.88-.2-.49-.41-.43-.57-.43-.15 0-.32-.02-.49-.02-.17 0-.45.06-.68.32-.23.25-.89.87-.89 2.12s.91 2.46 1.04 2.63c.13.17 1.79 2.73 4.34 3.83.61.26 1.08.42 1.45.54.61.19 1.17.17 1.61.1.49-.07 1.5-.61 1.71-1.21.21-.59.21-1.1.15-1.21-.06-.11-.23-.17-.48-.3z"/>
          </svg>
          <span>Chat on WhatsApp</span>
        </a>

        <!-- LinkedIn -->
        <a 
          href={siteConfig.contact.linkedin} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-secondary contact-btn linkedin-btn"
          aria-label="Connect with Maryem on LinkedIn (opens in a new tab)"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9h2.79v8.37H6.46v-8.37M7.86 6.31a1.63 1.63 0 0 0-1.63 1.63 1.63 1.63 0 0 0 1.63 1.63 1.63 1.63 0 0 0 1.63-1.63 1.63 1.63 0 0 0-1.63-1.63Z"/>
          </svg>
          <span>Connect on LinkedIn</span>
        </a>

        <!-- Direct Telephone Call -->
        <a 
          href={siteConfig.contact.phoneTel} 
          class="btn btn-highlight contact-btn phone-btn"
          aria-label="Call Maryem Essam directly"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>Call: {siteConfig.contact.phone}</span>
        </a>
      </div>

      <!-- Quick Copy Feature for Phone Number -->
      <div class="copy-box">
        <span class="copy-label">Direct Line:</span>
        <code class="phone-code" id="phone-number-code">{siteConfig.contact.phone}</code>
        <button type="button" class="copy-btn" id="copy-phone-btn" aria-label="Copy phone number to clipboard">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span id="copy-btn-text">Copy Number</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    background-color: var(--color-bg-primary);
    position: relative;
  }

  .contact-card {
    background-color: var(--color-card-bg);
    border: var(--border-bold);
    border-radius: var(--radius-lg);
    box-shadow: 8px 8px 0px var(--color-border);
    padding: clamp(2rem, 5vw, 4rem);
    text-align: center;
    max-width: 960px;
    margin-left: auto;
    margin-right: auto;
    position: relative;
    overflow: hidden;
  }

  .contact-top {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text-secondary);
  }

  .live-dot {
    width: 8px;
    height: 8px;
    background-color: #22C55E;
    border-radius: 50%;
    animation: pulseSubtle 2s infinite ease-in-out;
  }

  .contact-title {
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-bottom: 1.5rem;
  }

  .contact-copy {
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    color: var(--color-text-secondary);
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .contact-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .contact-btn {
    padding: 1rem 1.75rem;
    font-size: 0.9375rem;
  }

  .copy-box {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1rem;
    background-color: var(--color-bg-primary);
    border: var(--border-thin);
    border-radius: var(--radius-pill);
    box-shadow: 2px 2px 0px var(--color-border);
    margin-top: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .copy-label {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-text-muted);
  }

  .phone-code {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-xs);
    background-color: rgba(244, 91, 53, 0.1);
    transition: background-color var(--transition-fast);
  }

  .copy-btn:hover {
    background-color: rgba(244, 91, 53, 0.2);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const copyBtn = document.getElementById('copy-phone-btn');
    const phoneCode = document.getElementById('phone-number-code');
    const copyBtnText = document.getElementById('copy-btn-text');

    copyBtn?.addEventListener('click', async () => {
      const numberToCopy = phoneCode?.textContent?.trim() || '+201094960786';
      try {
        await navigator.clipboard.writeText(numberToCopy);
        if (copyBtnText) copyBtnText.textContent = 'Copied!';
        setTimeout(() => {
          if (copyBtnText) copyBtnText.textContent = 'Copy Number';
        }, 2000);
      } catch (err) {
        // Fallback for older browsers
        const textarea = document.createElement('textarea');
        textarea.value = numberToCopy;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
        if (copyBtnText) copyBtnText.textContent = 'Copied!';
        setTimeout(() => {
          if (copyBtnText) copyBtnText.textContent = 'Copy Number';
        }, 2000);
      }
    });
  });
</script>
