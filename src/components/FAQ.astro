---
import { faqData } from '../data/portfolio';
---

<section class="faq-section section-padding" id="faq" aria-label="Frequently Asked Questions">
  <div class="container">
    <!-- Header -->
    <div class="faq-header reveal-item">
      <span class="section-tag">
        <span class="tag-spark">✦</span> QUESTIONS &amp; CLARITY
      </span>
      <h2 class="section-title">
        FREQUENTLY ASKED <br />
        <span class="font-serif-italic">questions.</span>
      </h2>
      <p class="section-subtitle">
        Everything you need to know about my professional background, specialized services, and working style.
      </p>
    </div>

    <!-- Accordion List -->
    <div class="faq-accordion-list">
      {faqData.map((item, index) => (
        <details class={`faq-item reveal-item reveal-stagger-${index + 1}`} open={index === 0}>
          <summary class="faq-question">
            <span class="question-number">0{index + 1}</span>
            <span class="question-text">{item.question}</span>
            <span class="faq-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19" class="vertical-line"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </summary>
          <div class="faq-answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-section {
    background-color: #F8F3EA;
    border-bottom: var(--border-thin);
    position: relative;
  }

  .faq-header {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    max-width: 720px;
  }

  .tag-spark {
    color: var(--color-accent);
  }

  /* Accordion List */
  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 860px;
  }

  .faq-item {
    background-color: var(--color-card-bg);
    border: var(--border-bold);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-offset-sm);
    overflow: hidden;
    transition: box-shadow var(--transition-fast);
  }

  .faq-item[open] {
    box-shadow: var(--shadow-offset-md);
  }

  .faq-question {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--color-text-primary);
    user-select: none;
    position: relative;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .question-number {
    font-size: 0.875rem;
    font-weight: 900;
    color: var(--color-accent);
  }

  .question-text {
    flex: 1;
    line-height: 1.35;
  }

  .faq-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background-color: var(--color-bg-primary);
    transition: transform 0.3s ease, background-color var(--transition-fast);
    flex-shrink: 0;
  }

  .faq-item[open] .faq-icon {
    background-color: var(--color-accent);
    color: #FFFFFF;
    border-color: var(--color-accent);
  }

  .faq-item[open] .vertical-line {
    opacity: 0;
  }

  .faq-answer {
    padding: 0 1.5rem 1.5rem calc(1.5rem + 1.25rem + 1.5rem);
    animation: fadeIn 0.3s ease;
  }

  .faq-answer p {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  @media (max-width: 600px) {
    .faq-question {
      padding: 1rem;
      gap: 0.75rem;
    }
    .faq-answer {
      padding: 0 1rem 1.25rem 1rem;
    }
  }
</style>
