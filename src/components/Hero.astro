---
import { siteConfig } from '../data/portfolio';
---

<section class="hero-section" id="hero" aria-label="Introduction">
  <div class="container hero-container">
    <!-- Left Column: Editorial Headline & Actions -->
    <div class="hero-content">
      <!-- Tag / Issue Stamp -->
      <div class="hero-meta reveal-item reveal-stagger-1">
        <span class="badge-sticker orange">PORTFOLIO '26</span>
        <span class="hero-issue">EDITION 01 — THE SOCIAL EDIT</span>
      </div>

      <!-- Main Expressive Headline -->
      <h1 class="hero-title reveal-item reveal-stagger-2">
        I MAKE PEOPLE <br />
        <span class="highlight-wrapper">
          <span class="highlight-text">STOP &amp; LOOK.</span>
          <svg class="brush-underline" viewBox="0 0 320 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 14C85 6 220 4 316 11" stroke="#F45B35" stroke-width="7" stroke-linecap="round"/>
          </svg>
        </span>
      </h1>

      <!-- Supporting Editorial Bio -->
      <p class="hero-bio reveal-item reveal-stagger-3">
        {siteConfig.heroBio}
      </p>

      <!-- Professional Category Badges -->
      <div class="hero-roles reveal-item reveal-stagger-3">
        <span class="role-pill">
          <span class="role-bullet"></span> SOCIAL MEDIA
        </span>
        <span class="role-pill">
          <span class="role-bullet"></span> CONTENT CREATION
        </span>
        <span class="role-pill">
          <span class="role-bullet"></span> COMMUNITY MODERATION
        </span>
      </div>

      <!-- Action Buttons -->
      <div class="hero-ctas reveal-item reveal-stagger-4">
        <a 
          href={siteConfig.contact.whatsapp} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-primary hero-btn-main"
          aria-label="Let's Work Together on WhatsApp"
        >
          <span>Let's Work Together</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>

        <a href="#work" class="btn btn-secondary hero-btn-sub">
          <span>Explore My Work</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
        </a>
      </div>

      <!-- Scroll Invitation -->
      <div class="hero-scroll reveal-item reveal-stagger-5">
        <a href="#about" class="scroll-link" aria-label="Scroll down to About section">
          <span class="scroll-mouse">
            <span class="scroll-wheel"></span>
          </span>
          <span class="scroll-text">SCROLL TO DISCOVER</span>
        </a>
      </div>
    </div>

    <!-- Right Column: Asymmetric Editorial Portrait Composition -->
    <div class="hero-visual reveal-item reveal-stagger-2">
      <!-- Background Organic Tangerine Blob -->
      <div class="tangerine-organic-shape animate-float" aria-hidden="true"></div>

      <!-- Secondary Soft Sage Angular Frame -->
      <div class="sage-backdrop-card" aria-hidden="true"></div>

      <!-- Main Portrait Frame Container -->
      <div class="portrait-editorial-frame">
        <div class="portrait-header">
          <span class="frame-dot red"></span>
          <span class="frame-dot yellow"></span>
          <span class="frame-dot green"></span>
          <span class="frame-caption">MARYEM_ESSAM_PORTRAIT.RAW</span>
        </div>

        <!-- Artistic Placeholder for Maryem's Photo -->
        <div class="portrait-canvas">
          <div class="placeholder-graphic">
            <!-- Editorial Monogram Stamp -->
            <div class="canvas-monogram">ME</div>
            <div class="canvas-rings">
              <svg viewBox="0 0 200 200" class="ring-svg">
                <circle cx="100" cy="100" r="85" fill="none" stroke="#171717" stroke-width="2" stroke-dasharray="8 6"/>
                <circle cx="100" cy="100" r="65" fill="none" stroke="#F45B35" stroke-width="2"/>
              </svg>
            </div>
            <div class="placeholder-tagline">
              <span class="tagline-badge">MARYEM ESSAM</span>
              <p class="tagline-instruction">
                Editorial Portrait Frame<br />
                <span class="subtext">Drop <code>maryem.jpg</code> to display original photo</span>
              </p>
            </div>
          </div>
        </div>

        <!-- Floating Annotation Sticker 1 (Top Right) -->
        <div class="floating-sticker sticker-top animate-float-alt">
          <span class="sticker-star">✦</span>
          <span>COMMERCE GRADUATE</span>
        </div>

        <!-- Floating Annotation Sticker 2 (Bottom Left) -->
        <div class="floating-sticker sticker-bottom">
          <span class="sticker-dot"></span>
          <span>SHEIN SALES EXPERIENCE</span>
        </div>

        <!-- Editorial Stamp Badge (Bottom Right) -->
        <div class="editorial-stamp animate-spin-slow" aria-hidden="true">
          <svg viewBox="0 0 120 120" width="90" height="90">
            <path id="curvePath" d="M 60, 60 m -45, 0 a 45,45 0 1,1 90,0 a 45,45 0 1,1 -90,0" fill="transparent"/>
            <text font-family="'Space Grotesk', sans-serif" font-size="10.5" font-weight="800" fill="#171717" letter-spacing="2">
              <textPath href="#curvePath">
                • THE SOCIAL EDIT • SOCIAL MEDIA SPECIALIST
              </textPath>
            </text>
          </svg>
          <div class="stamp-center">✦</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 992px) {
    .hero-container {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3rem;
    }
  }

  /* Left Column */
  .hero-content {
    display: flex;
    flex-direction: column;
    z-index: 2;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .hero-issue {
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
  }

  .hero-title {
    font-size: clamp(2.5rem, 6.2vw, 4.75rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-bottom: 1.5rem;
  }

  .highlight-wrapper {
    position: relative;
    display: inline-block;
  }

  .highlight-text {
    color: var(--color-accent);
  }

  .brush-underline {
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 100%;
    height: 14px;
    pointer-events: none;
  }

  .hero-bio {
    font-size: clamp(1.0625rem, 1.8vw, 1.25rem);
    color: var(--color-text-secondary);
    line-height: 1.65;
    max-width: 580px;
    margin-bottom: 1.75rem;
  }

  /* Roles Pills */
  .hero-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2.25rem;
  }

  .role-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 1rem;
    background-color: var(--color-bg-secondary);
    color: var(--color-text-primary);
    font-family: var(--font-heading);
    font-size: 0.78125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    border: var(--border-thin);
    border-radius: var(--radius-sm);
    box-shadow: 2px 2px 0px var(--color-border);
  }

  .role-bullet {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent);
  }

  /* Action Buttons */
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .hero-btn-main {
    padding: 1rem 2rem;
    font-size: 1rem;
  }

  .hero-btn-sub {
    padding: 1rem 1.75rem;
    font-size: 1rem;
  }

  /* Scroll Invitation */
  .hero-scroll {
    display: flex;
    align-items: center;
  }

  .scroll-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    transition: color var(--transition-fast);
  }

  .scroll-link:hover {
    color: var(--color-accent);
  }

  .scroll-mouse {
    width: 20px;
    height: 32px;
    border: 2px solid var(--color-text-primary);
    border-radius: 12px;
    display: flex;
    justify-content: center;
    padding-top: 4px;
  }

  .scroll-wheel {
    width: 4px;
    height: 6px;
    background-color: var(--color-accent);
    border-radius: 2px;
    animation: floatGentle 2s infinite ease-in-out;
  }

  /* Right Visual Composition */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 440px;
    padding: 1.5rem;
  }

  /* Organic Tangerine Shape */
  .tangerine-organic-shape {
    position: absolute;
    width: 380px;
    height: 380px;
    top: 5%;
    right: 5%;
    background-color: var(--color-accent);
    opacity: 0.95;
    border: var(--border-bold);
    border-radius: 42% 58% 70% 30% / 45% 45% 55% 55%;
    box-shadow: 6px 6px 0px var(--color-border);
    z-index: 1;
    transform-origin: center;
  }

  /* Sage Backdrop Card */
  .sage-backdrop-card {
    position: absolute;
    width: 320px;
    height: 420px;
    bottom: -15px;
    left: 8%;
    background-color: var(--color-bg-secondary);
    border: var(--border-bold);
    border-radius: var(--radius-md);
    box-shadow: 4px 4px 0px var(--color-border);
    transform: rotate(-4deg);
    z-index: 1;
  }

  /* Main Portrait Frame */
  .portrait-editorial-frame {
    position: relative;
    width: 100%;
    max-width: 340px;
    background-color: var(--color-card-bg);
    border: var(--border-bold);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-offset-lg);
    z-index: 2;
    overflow: visible;
  }

  .portrait-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.65rem 1rem;
    border-bottom: var(--border-thin);
    background-color: #FAF6EF;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  .frame-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
  }

  .frame-dot.red { background-color: var(--color-accent); }
  .frame-dot.yellow { background-color: var(--color-highlight); }
  .frame-dot.green { background-color: var(--color-bg-secondary); }

  .frame-caption {
    margin-left: auto;
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  /* Portrait Canvas */
  .portrait-canvas {
    height: 380px;
    background: linear-gradient(145deg, #FFFDF8, #F1E9DA);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    overflow: hidden;
  }

  .placeholder-graphic {
    text-align: center;
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
  }

  .canvas-rings {
    position: absolute;
    width: 180px;
    height: 180px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -60%);
    pointer-events: none;
  }

  .ring-svg {
    width: 100%;
    height: 100%;
  }

  .canvas-monogram {
    font-family: var(--font-heading);
    font-size: 5rem;
    font-weight: 900;
    color: var(--color-text-primary);
    letter-spacing: -0.06em;
    margin-bottom: 1.5rem;
    z-index: 2;
    text-shadow: 3px 3px 0px #F5C94A;
  }

  .placeholder-tagline {
    z-index: 2;
    margin-top: auto;
  }

  .tagline-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background-color: var(--color-text-primary);
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    border-radius: var(--radius-xs);
    margin-bottom: 0.5rem;
  }

  .tagline-instruction {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  .tagline-instruction .subtext {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  .tagline-instruction code {
    background-color: rgba(23, 23, 23, 0.08);
    padding: 2px 4px;
    border-radius: 3px;
    font-weight: 600;
  }

  /* Floating Stickers */
  .floating-sticker {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    font-family: var(--font-heading);
    font-size: 0.71875rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    border: var(--border-bold);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-offset-sm);
    z-index: 3;
    white-space: nowrap;
  }

  .sticker-top {
    top: -16px;
    right: -24px;
    background-color: var(--color-highlight);
    color: var(--color-text-primary);
    transform: rotate(3deg);
  }

  .sticker-bottom {
    bottom: -16px;
    left: -20px;
    background-color: var(--color-bg-secondary);
    color: var(--color-text-primary);
    transform: rotate(-3deg);
  }

  .sticker-star {
    color: var(--color-accent);
    font-size: 0.9rem;
  }

  .sticker-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-accent);
  }

  /* Editorial Circular Stamp */
  .editorial-stamp {
    position: absolute;
    bottom: -35px;
    right: -35px;
    width: 90px;
    height: 90px;
    background-color: var(--color-card-bg);
    border: var(--border-bold);
    border-radius: 50%;
    box-shadow: var(--shadow-offset-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 4;
  }

  .stamp-center {
    position: absolute;
    font-size: 1.25rem;
    color: var(--color-accent);
  }

  @media (max-width: 600px) {
    .tangerine-organic-shape {
      width: 280px;
      height: 280px;
      right: 0;
    }
    .sage-backdrop-card {
      width: 260px;
      left: 0;
    }
    .floating-sticker.sticker-top {
      right: 0;
    }
    .floating-sticker.sticker-bottom {
      left: 0;
    }
    .editorial-stamp {
      right: -10px;
      bottom: -20px;
      width: 76px;
      height: 76px;
    }
  }
</style>
